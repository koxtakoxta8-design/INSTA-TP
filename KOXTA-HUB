f10(6, InstaTPButton)

local function GetBestEgg()
    local ok, target = pcall(function()
        return v60.Best()
    end)

    if not ok or type(target) ~= 'table' or type(target.rec) ~= 'table' then
        return nil
    end

    return target
end

local function RefreshBestEgg()
    local target = GetBestEgg()

    if not target then
        InstaTPCurrentUid = nil
        v45.SetUiProperty(InstaTPName, 'Text', 'BEST EGG: no disponible')
        v45.SetUiProperty(InstaTPMoney, 'Text', '$0/s')
        v45.SetUiProperty(InstaTPRarity, 'Text', '')
        return
    end

    local rec = target.rec
    local info = target.info or {}

    InstaTPCurrentUid = rec.Uid

    local name = tostring(info.name or rec.AssetCategory or 'Egg')
    local rarity = tostring(info.rarity or rec.Rarity or '')

    local money = tonumber(target.mps)

    if not money then
        local okMoney, result = pcall(function()
            return v60.MoneyPerSecond(rec)
        end)

        money = okMoney and tonumber(result) or 0
    end

    v45.SetUiProperty(InstaTPName, 'Text', 'BEST EGG: ' .. name)
    v45.SetUiProperty(InstaTPMoney, 'Text', f3(money) .. '/s')
    v45.SetUiProperty(InstaTPRarity, 'Text', rarity)
end

InstaTPButton.MouseButton1Click:Connect(function()
    if InstaTPBusy then
        return
    end

    InstaTPBusy = true

    task.spawn(function()
        local ok, err = pcall(function()

            -- Detecta el mejor huevo justo al pulsar.
            local target = GetBestEgg()

            if not target or not target.rec then
                f7('INSTA TP: no hay huevo disponible')
                return
            end

            local rec = target.rec
            local position = rec.BottomCFrame and rec.BottomCFrame.Position

            if typeof(position) ~= 'Vector3' then
                f7('INSTA TP: el huevo no tiene posicion')
                return
            end

            InstaTPCurrentUid = rec.Uid

            v45.SetUiProperty(InstaTPButton, 'Text', 'TP...')

            -- SOLO HACE TP AL MEJOR HUEVO.
            v257.To(
                position,
                v51.ApproachRadius or 9,
                v51.MaxTravelTime
            )

            -- TERMINA AQUI.
            -- NO RECOGE EL HUEVO.
            -- NO ESPERA.
            -- NO BLOQUEA AL JUGADOR.
            -- NO HACE NINGUNA ACCION DESPUES DEL TP.

        end)

        v45.SetUiProperty(InstaTPButton, 'Text', 'INSTA TP')

        if not ok then
            f7('INSTA TP ERROR: ' .. tostring(err))
        end

        InstaTPBusy = false
    end)
end)

-- Solo actualiza la información mostrada.
task.spawn(function()
    while v77 and v77.Parent do
        pcall(RefreshBestEgg)
        task.wait(1)
    end
end)

pcall(RefreshBestEgg)
