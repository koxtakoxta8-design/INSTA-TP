        Stroke.Transparency = 0.08 + Pulse * 0.18

        RunService.RenderStepped:Wait()
    end
end)

--==================================================
-- DETECCIÓN DEL PROMPT
--==================================================

local WatchedPrompts = {}

local function WatchPrompt(Prompt)
    if not Prompt:IsA("ProximityPrompt") then
        return
    end

    if WatchedPrompts[Prompt] then
        return
    end

    WatchedPrompts[Prompt] = true

    Prompt.Triggered:Connect(function()
        ShowInterface()
    end)
end

for _, Object in ipairs(workspace:GetDescendants()) do
    if Object:IsA("ProximityPrompt") then
        WatchPrompt(Object)
    end
end

workspace.DescendantAdded:Connect(function(Object)
    if Object:IsA("ProximityPrompt") then
        WatchPrompt(Object)
    end
end)

--==================================================
-- PUENTE COM O SEU BUSY
--==================================================

task.spawn(function()
    local WasBusy = false

    while task.wait(0.1) do

        if typeof(Busy) == "boolean" then

            if Busy and not WasBusy then
                ShowInterface()
            end

            if not Busy and WasBusy then
                SetStatus("SECUENCIA TERMINADA")
                SetGrab("FINALIZADO")

                task.wait(0.5)

                HideInterface()
            end

            WasBusy = Busy
        end

    end
end)

