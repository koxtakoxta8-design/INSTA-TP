--==================================================
-- SISTEMA ORIGINAL FOTO 1 / FOTO 2
--==================================================

local function TP(Character, Position)
    if not Character or not Character.Parent then
        return false
    end

    Character:PivotTo(CFrame.new(Position))
    RunService.Heartbeat:Wait()

    return true
end

local function WaitForStableRespawn(OldCharacter)

    local Character

    repeat
        task.wait()
        Character = Player.Character
    until Character
        and Character ~= OldCharacter
        and Character.Parent

    local Humanoid =
        Character:WaitForChild("Humanoid")

    local Root =
        Character:WaitForChild("HumanoidRootPart")

    while Humanoid.Health <= 0 do
        task.wait()
    end

    local LastPosition = Root.Position
    local StableTime = 0

    while StableTime < 0.4 do

        task.wait(0.05)

        if not Character.Parent then
            return WaitForStableRespawn(OldCharacter)
        end

        if not Root.Parent then
            Root =
                Character:WaitForChild(
                    "HumanoidRootPart"
                )

            LastPosition = Root.Position
            StableTime = 0

            continue
        end

        local CurrentPosition =
            Root.Position

        local Movement =
            (CurrentPosition - LastPosition).Magnitude

        if Movement < 0.05 then
            StableTime += 0.05
        else
            StableTime = 0
        end

        LastPosition = CurrentPosition

    end

    return Character
end

--==================================================
-- CAMINADORA MÁS CERCANA
--==================================================

local function GetNearestTreadmill()

    local BestPoint
    local BestDistance = math.huge

    for _, Position in ipairs(Caminadoras) do

        local Distance =
            (RespawnPoint - Position).Magnitude

        if Distance < BestDistance then
            BestDistance = Distance
            BestPoint = Position
        end

    end

    return BestPoint
end

--==================================================
-- FOTO 1
-- MISMA LÓGICA: DESLIZAR -> 65% -> TP
--==================================================

local function MoveToPhoto1(Character)

    if not Character or not Character.Parent then
        return false
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false
    end

    local Speed = 1000
    local ArrivalDistance = 0.5

    local StartPosition =
        Root.Position

    local TotalDistance =
        (Foto1 - StartPosition).Magnitude

    if TotalDistance <= ArrivalDistance then

        Character:PivotTo(
            CFrame.new(Foto1)
        )

        return true
    end

    while Character.Parent
        and Root.Parent do

        local CurrentPosition =
            Root.Position

        local Distance =
            (Foto1 - CurrentPosition).Magnitude

        if Distance <= ArrivalDistance then

            Character:PivotTo(
                CFrame.new(Foto1)
            )

            return true
        end

        local DistanceTravelled =
            TotalDistance - Distance

        local Progress =
            DistanceTravelled /
            TotalDistance

        -- EXACTAMENTE AL 65%
        if Progress >= 0.65 then

            Character:PivotTo(
                CFrame.new(Foto1)
            )

            RunService.Heartbeat:Wait()

            if Root.Parent then
                Character:PivotTo(
                    CFrame.new(Foto1)
                )
            end

            return true
        end

        local Direction =
            (Foto1 - CurrentPosition).Unit

        local Delta =
            RunService.Heartbeat:Wait()

        local Step =
            math.min(
                Speed * Delta,
                Distance
            )

        Root.CFrame =
            CFrame.new(
                CurrentPosition +
                Direction * Step
            )

    end

    return false
end

--==================================================
-- POSICIÓN DEL PROMPT
--==================================================

local function GetPromptPosition(Prompt)

    if not Prompt or not Prompt.Parent then
        return nil
    end

    local Parent =
        Prompt.Parent

    if Parent:IsA("BasePart") then
        return Parent.Position
    end

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    local Part =
        Parent:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if Part then
        return Part.Position
    end

    return nil
end

--==================================================
-- PROMPT MÁS CERCANO A FOTO 1
-- NO FILTRA POR NOMBRE NI TEXTO
--==================================================

local function FindNearestPromptFromPhoto1()

    local BestPrompt
    local BestDistance = math.huge

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        if Object:IsA("ProximityPrompt")
            and Object.Enabled then

            local Position =
                GetPromptPosition(Object)

            if Position then

                local Distance =
                    (Foto1 - Position).Magnitude

                if Distance < BestDistance then

                    BestDistance = Distance
                    BestPrompt = Object

                end

            end

        end

    end

    return BestPrompt
end

--==================================================
-- ACTIVAR PROMPT
--==================================================

local function TriggerPrompt(Prompt)

    if not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled then

        return false
    end

    local Triggered = false

    local Connection =
        Prompt.Triggered:Connect(function()
            Triggered = true
        end)

    pcall(function()
        Prompt.HoldDuration = 0
    end)

    pcall(function()
        Prompt.RequiresLineOfSight = false
    end)

    -- Usar fireproximityprompt si está disponible.
    local Fired = false

    pcall(function()
        fireproximityprompt(Prompt)
        Fired = true
    end)

    if not Triggered then

        pcall(function()

            Prompt:InputHoldBegin()
            Prompt:InputHoldEnd()

        end)

    end

    local StartTime = os.clock()

    while not Triggered
        and os.clock() - StartTime < 0.5 do

        RunService.Heartbeat:Wait()

        -- Si desaparece o se desactiva, el juego procesó el prompt.
        if not Prompt.Parent
            or not Prompt.Enabled then

            Triggered = true
            break
        end

    end

    if Connection then
        Connection:Disconnect()
    end

    return Triggered or Fired
end

--==================================================
-- GRAB EN FOTO 1
--==================================================

local function AutoGrabAtPhoto1(Character)

    if not Character
        or not Character.Parent then

        return false
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false
    end

    -- Mantener al personaje exactamente en Foto 1.
    Character:PivotTo(
        CFrame.new(Foto1)
    )

    RunService.Heartbeat:Wait()

    local StartTime = os.clock()

    while os.clock() - StartTime < 1.5 do

        local Prompt =
            FindNearestPromptFromPhoto1()

        if Prompt then

            local PromptPosition =
                GetPromptPosition(Prompt)

            if PromptPosition then

                -- Solo aceptar el prompt que realmente está
                -- cerca de Foto 1.
                local Distance =
                    (Foto1 - PromptPosition).Magnitude

                if Distance <= 12 then

                    if TriggerPrompt(Prompt) then
                        return true
                    end

                end

            end

        end

        RunService.Heartbeat:Wait()

    end

    return false
end

--==================================================
-- SECUENCIA PRINCIPAL
--==================================================

local function StartSequence()

    if Busy then
        return
    end

    if not Enabled then
        return
    end

    Busy = true

    Status.Text =
        "●  SYSTEM ACTIVE"

    local Character =
        Player.Character

    if not Character
        or not Character.Parent then

        Busy = false
        return
    end

    local NearestPoint =
        GetNearestTreadmill()

    --==================================================
    -- 20 CICLOS ORIGINALES
    --==================================================

    for Cycle = 1,20 do

        if not Character
            or not Character.Parent then

            Busy = false
            return
        end

        TP(
            Character,
            RespawnPoint
        )

        if NearestPoint then

            TP(
                Character,
                NearestPoint
            )

        end

        print(
            "CICLO " ..
            Cycle ..
            "/20"
        )

    end

    --==================================================
    -- RESPAWN ORIGINAL
    --==================================================

    local OldCharacter =
        Character

    local Humanoid =
        OldCharacter:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then
        Busy = false
        return
    end

    Humanoid.Health = 0

    Character =
        WaitForStableRespawn(
            OldCharacter
        )

    if not Character then
        Busy = false
        return
    end

    --==================================================
    -- FOTO 1
    --==================================================

    Status.Text =
        "●  MOVING TO PHOTO 1"

    local Arrived =
        MoveToPhoto1(Character)

    if not Arrived then
        Busy = false
        return
    end

    --==================================================
    -- GRAB EN FOTO 1
    --==================================================

    Status.Text =
        "●  ACTIVATING TARGET"

    local Grabbed =
        AutoGrabAtPhoto1(
            Character
        )

    --==================================================
    -- FOTO 2 INMEDIATA
    --==================================================

    if Grabbed then

        Status.Text =
            "●  TARGET GRABBED"

        -- SIN ESPERA ARTIFICIAL
        TP(
            Character,
            Foto2
        )

        Status.Text =
            "●  SYSTEM READY"

    else

        Status.Text =
            "●  TARGET NOT FOUND"

    end

    Busy = false
end

