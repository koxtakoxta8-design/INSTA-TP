local function ConnectPrompt(Prompt)

    if not Prompt:IsA(
        "ProximityPrompt"
    ) then
        return
    end

    if Connections[Prompt] then
        return
    end

    Connections[Prompt] =
        Prompt.Triggered:Connect(
            function()

                if Busy then
                    return
                end

                print(
                    "PROMPT MANUAL ACTIVADO"
                )

                task.spawn(
                    StartSequence
                )
            end
        )
end

