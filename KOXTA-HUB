--==================================================
-- SECUENCIA DE PRUEBA
-- PROMPT
-- -> 20 CICLOS
-- -> RESPAWN ESTABLE
-- -> DESLIZAMIENTO FOTO 2 (1000)
-- -> 65% -> TP FOTO 2
-- -> AUTO GRAB: HUEVO / ROBAR
-- -> ESPERA SOLO LO NECESARIO PARA CONFIRMAR
-- -> 0.5 SEGUNDOS
-- -> TP FOTO 3
--==================================================

local Players = game:GetService("Players")
