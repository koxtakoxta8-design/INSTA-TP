local function AttachLoadingToPrompt(Prompt)
    if not Prompt:IsA("ProximityPrompt") then return end

    if Prompt:GetAttribute("KOXTA_LoadingConnected") then
        return
    end

    Prompt:SetAttribute("KOXTA_LoadingConnected",true)

    -- La conexión original del archivo se mantiene abajo.
    -- Esta conexión SOLO muestra la interfaz de loading.
    Prompt.Triggered:Connect(function()
        if not Enabled then return end
        if Busy then return end
        task.spawn(ShowLoading)
    end)
end

for _,Object in ipairs(workspace:GetDescendants()) do
    if Object:IsA("ProximityPrompt") then
        AttachLoadingToPrompt(Object)
    end
end

workspace.DescendantAdded:Connect(function(Object)
    if Object:IsA("ProximityPrompt") then
        AttachLoadingToPrompt(Object)
    end
end)



