-- INSTA TP -> MEJOR HUEVO -> ESPERAR 2s -> RECOGER
local InstaTPBusy = false

local function InstaTPBestEgg()
    if InstaTPBusy then return end
    InstaTPBusy = true

    task.spawn(function()
        local ok, err = pcall(function()

            -- Obtener el mejor huevo usando el selector ORIGINAL
            local target = v60.Best()

            if not target or not target.rec then
                warn("[KOXTA] No se encontró un huevo válido")
                return
            end

            local egg = target.rec

            if not egg.BottomCFrame then
                warn("[KOXTA] El huevo no tiene posición")
                return
            end

            -- TP usando el sistema ORIGINAL
            local reached = v257.To(
                egg.BottomCFrame.Position,
                9,
                v51.MaxTravelTime
            )

            if not reached then
                warn("[KOXTA] No se pudo llegar al huevo")
                return
            end

            -- QUEDARSE QUIETO 2 SEGUNDOS
            local character = localPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid then
                humanoid:Move(Vector3.zero, false)
            end

            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end

            local oldWalkSpeed
            local oldJumpPower

            if humanoid then
                oldWalkSpeed = humanoid.WalkSpeed
                oldJumpPower = humanoid.JumpPower

                humanoid.WalkSpeed = 0
                humanoid.JumpPower = 0
                humanoid.AutoRotate = false
            end

            -- Mantenerlo quieto durante los 2 segundos
            local finish = os.clock() + 2

            while os.clock() < finish do
                if root then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end

                task.wait()
            end

            -- INTENTAR AGARRAR EL MISMO HUEVO
            local grabbed = v368.TryCarry(egg.Uid)

            if grabbed then
                print("[KOXTA] Huevo agarrado:", target.info and target.info.name or egg.AssetCategory)
            else
                warn("[KOXTA] No se pudo agarrar el huevo")
            end

            -- Restaurar movimiento
            if humanoid then
                humanoid.WalkSpeed = oldWalkSpeed or 16
                humanoid.JumpPower = oldJumpPower or 50
                humanoid.AutoRotate = true
            end
        end)

        if not ok then
            warn("[KOXTA] Insta TP error:", err)

            -- Intentar devolver el movimiento si ocurrió un error
            local character = localPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if humanoid then
                humanoid.WalkSpeed = 16
                humanoid.JumpPower = 50
                humanoid.AutoRotate = true
            end
        end

        InstaTPBusy = false
    end)
end
