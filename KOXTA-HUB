local function ShowLoading()

    LoadingScreen.Visible = true

    LoadingScreen.BackgroundTransparency = 0
    LoadingTitle.TextTransparency = 1
    LoadingText.TextTransparency = 1

    Bar.Size =
        UDim2.new(
            0,
            0,
            1,
            0
        )

    Percent.Text = "0%"

    Tween(
        LoadingTitle,
        0.45,
        {
            TextTransparency = 0
        },
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )

    Tween(
        LoadingText,
        0.45,
        {
            TextTransparency = 0
        },
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )

    for i = 0,100,2 do

        if not LoadingScreen.Visible then
            return
        end

        Bar.Size =
            UDim2.new(
                i / 100,
                0,
                1,
                0
            )

        Percent.Text =
            tostring(i) .. "%"

        task.wait(0.015)

    end

    task.wait(0.15)

    Tween(
        LoadingScreen,
        0.35,
        {
            BackgroundTransparency = 1
        },
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.In
    )

    Tween(
        LoadingTitle,
        0.25,
        {
            TextTransparency = 1
        }
    )

    Tween(
        LoadingText,
        0.25,
        {
            TextTransparency = 1
        }
    )

    task.wait(0.4)

    LoadingScreen.Visible = false
    LoadingScreen.BackgroundTransparency = 0

end

