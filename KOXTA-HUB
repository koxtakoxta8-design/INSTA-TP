local function LS_Show()
    -- Cada nueva activación comienza una nueva carga.
    -- Nunca toca ni reinicia el sistema de 20 ciclos.
    if LS_Gui.Enabled then return end

    LS_Started = true
    LS_Closed = false
    LS_Gui.Enabled = true
    LS_Bar.Size = UDim2.fromScale(0, 1)
    LS_Percent.Text = "0%"
    LS_Status.Text = "CARGANDO..."

    LS_TweenService:Create(
        LS_Bar,
        TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
        {Size = UDim2.fromScale(0.72, 1)}
    ):Play()

    task.spawn(function()
        while LS_Gui.Enabled and not LS_Closed do
            LS_Shine.Offset = Vector2.new(-1, 0)
            local T = LS_TweenService:Create(
                LS_Shine,
                TweenInfo.new(1.25, Enum.EasingStyle.Linear),
                {Offset = Vector2.new(1, 0)}
            )
            T:Play()
            T.Completed:Wait()
            task.wait(0.35)
        end
    end)

    task.spawn(function()
        local Start = os.clock()
        while LS_Gui.Enabled and not LS_Closed do
            local Elapsed = os.clock() - Start
            local Percent = math.min(95, math.floor(72 + Elapsed * 4))
            LS_Percent.Text = tostring(Percent) .. "%"
            task.wait(0.08)
        end
    end)
end

local function LS_Hide()
    if LS_Closed then return end
    LS_Closed = true
    LS_Gui.Enabled = false
end

