local function StartSequence()

    if Busy then
        return
    end

    Busy = true

    local Character =
        Player.Character

    if not Character then
        Busy = false
        return
    end

    print("INICIANDO SECUENCIA")

    --================================================
    -- 20 CICLOS
    -- MISMA MECANICA ORIGINAL
    --================================================

    for Cycle = 1, 20 do

        if not Character
            or not Character.Parent then

            Busy = false
            return
        end

        TP(
            Character,
            RespawnPoint
        )

        CoreRunService.Heartbeat:Wait()

        if NearestPoint then

            TP(
                Character,
                NearestPoint
            )
        end

        CoreRunService.Heartbeat:Wait()

        print(
            "CICLO "
            .. Cycle
            .. "/20"
        )
    end

    print("20 CICLOS TERMINADOS")

    --================================================
    -- RESPAWN
    --================================================

    local OldCharacter = Character

    local Humanoid =
        OldCharacter:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then
        Busy = false
        return
    end

    Humanoid.Health = 0

    Character =
        WaitForStableRespawn(
            OldCharacter
        )

    if not Character then
        Busy = false
        return
    end

    --================================================
    -- FOTO 1
    -- 65% + TP
    --================================================

    if not MoveToPhoto1(Character) then

        print(
            "NO SE PUDO LLEGAR A FOTO 1"
        )

        Busy = false
        return
    end

    --================================================
    -- ASEGURAR FOTO 1
    --================================================

    Character =
        Player.Character

    if not Character
        or not Character.Parent then

        Busy = false
        return
    end

    TP(
        Character,
        Photo1
    )

    CoreRunService.Heartbeat:Wait()

    --================================================
    -- AGARRAR OBJETO
    --================================================

    local Grabbed =
        AutoGrab()

    if not Grabbed then

        print(
            "GRAB NO CONFIRMADO"
        )

        Busy = false
        return
    end

    --================================================
    -- GRAB CONFIRMADO
    -- TP INMEDIATO FOTO 2
    --================================================

    Character =
        Player.Character

    if not Character
        or not Character.Parent then

        Busy = false
        return
    end

    print(
        "GRAB CONFIRMADO -> FOTO 2"
    )

    TP(
        Character,
        Photo2
    )

    print(
        "FOTO 2 CONFIRMADA"
    )

    print(
        "SECUENCIA TERMINADA"
    )

    Busy = false
end

