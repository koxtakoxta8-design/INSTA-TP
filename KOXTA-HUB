--==================================================
-- TP
--==================================================

local function TP(Character, Position)

    if not Character or not Character.Parent then
        return false
    end

    Character:PivotTo(
        CFrame.new(Position)
    )

    return true
end

--==================================================
-- DESLIZAMIENTO A FOTO 1
-- 1000 DE VELOCIDAD
-- 65% -> TP INMEDIATO
--==================================================

local function MoveToPhoto1(Character)

    if not Character or not Character.Parent then
        return false
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return false
    end

    local Speed = 1000
    local ArrivalDistance = 0.5

    local StartPosition = Root.Position

    local TotalDistance =
        (Photo1 - StartPosition).Magnitude

    if TotalDistance <= ArrivalDistance then
        Character:PivotTo(CFrame.new(Photo1))
        return true
    end

    print("DESLIZAMIENTO -> FOTO 1")

    while Character.Parent and Root.Parent do

        local CurrentPosition = Root.Position

        local Distance =
            (Photo1 - CurrentPosition).Magnitude

        if Distance <= ArrivalDistance then

            Character:PivotTo(
                CFrame.new(Photo1)
            )

            return true
        end

        --==========================================
        -- CALCULAR PORCENTAJE
        --==========================================

        local DistanceTravelled =
            TotalDistance - Distance

        local Progress =
            DistanceTravelled / TotalDistance

        --==========================================
        -- 65% -> TP FOTO 1
        --==========================================

        if Progress >= 0.65 then

            print("65% -> TP FOTO 1")

            Character:PivotTo(
                CFrame.new(Photo1)
            )

            CoreRunService.Heartbeat:Wait()

            -- Reforzar posición
            if Root.Parent then
                Character:PivotTo(
                    CFrame.new(Photo1)
                )
            end

            print("FOTO 1 CONFIRMADA")

            return true
        end

        --==========================================
        -- DESLIZAMIENTO
        --==========================================

        local Direction =
            (Photo1 - CurrentPosition).Unit

        local Delta =
            CoreRunService.Heartbeat:Wait()

        local Step =
            math.min(
                Speed * Delta,
                Distance
            )

        Root.CFrame =
            CFrame.new(
                CurrentPosition +
                Direction * Step
            )
    end

    return false
end

--==================================================
-- POSICION DE CUALQUIER PROMPT
--==================================================

local function GetPromptPosition(Prompt)

    if not Prompt or not Prompt.Parent then
        return nil
    end

    local Parent = Prompt.Parent

    if Parent:IsA("BasePart") then
        return Parent.Position
    end

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    local Part =
        Parent:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if Part then
        return Part.Position
    end

    return nil
end

--==================================================
-- BUSCAR EL PROXIMITYPROMPT MAS CERCANO
--
-- NO FILTRA POR NOMBRE.
-- PUEDE SER HUEVO, CAJA, OBJETO, ETC.
--==================================================

local function FindNearestPrompt(Root)

    if not Root or not Root.Parent then
        return nil
    end

    local BestPrompt = nil
    local BestDistance = math.huge

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        if Object:IsA("ProximityPrompt")
            and Object.Enabled then

            local Position =
                GetPromptPosition(Object)

            if Position then

                local Distance =
                    (Root.Position - Position).Magnitude

                if Distance < BestDistance then

                    BestDistance = Distance
                    BestPrompt = Object

                end
            end
        end
    end

    return BestPrompt
end

--==================================================
-- AUTO GRAB RAPIDO
--
-- BUSCA CUALQUIER PROMPT CERCANO
-- Y REINTENTA DURANTE UN PEQUEÑO MARGEN.
--==================================================

local function AutoGrab()

    local Character =
        Player.Character

    if not Character or not Character.Parent then
        return false
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false
    end

    -- Dar un instante para que el objeto
    -- quede completamente cargado después del TP.
    task.wait(0.15)

    local StartTime = os.clock()
    local Timeout = 1.5

    while os.clock() - StartTime < Timeout do

        Character = Player.Character

        if not Character or not Character.Parent then
            return false
        end

        Root =
            Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not Root then
            return false
        end

        local Prompt =
            FindNearestPrompt(Root)

        if Prompt then

            print(
                "PROMPT ENCONTRADO: "
                .. Prompt:GetFullName()
            )

            pcall(function()
                Prompt.HoldDuration = 0
                Prompt.RequiresLineOfSight = false
            end)

            --======================================
            -- CONFIRMACION
            --======================================

            local Confirmed = false

            local Connection

            Connection =
                Prompt.Triggered:Connect(
                    function()
                        Confirmed = true
                    end
                )

            --======================================
            -- ACTIVACION RAPIDA
            --======================================

            pcall(function()
                Prompt:InputHoldBegin()
                Prompt:InputHoldEnd()
            end)

            --======================================
            -- ESPERAR CONFIRMACION
            --======================================

            local ConfirmStart = os.clock()

            while
                not Confirmed
                and
                os.clock() - ConfirmStart < 0.35
            do

                CoreRunService.Heartbeat:Wait()

                if not Prompt.Parent then
                    Confirmed = true
                    break
                end

                if not Prompt.Enabled then
                    Confirmed = true
                    break
                end
            end

            if Connection then
                Connection:Disconnect()
            end

            --======================================
            -- CONFIRMADO
            --======================================

            if Confirmed then

                print("OBJETO AGARRADO")

                return true
            end

            --======================================
            -- REINTENTO RAPIDO
            --======================================

            if Prompt.Parent and Prompt.Enabled then

                pcall(function()
                    Prompt:InputHoldBegin()
                    Prompt:InputHoldEnd()
                end)

                CoreRunService.Heartbeat:Wait()

                if not Prompt.Parent
                    or not Prompt.Enabled then

                    return true
                end
            end
        end

        CoreRunService.Heartbeat:Wait()
    end

    print("NO SE CONFIRMO EL GRAB")

    return false
end

--==================================================
-- RESPAWN ESTABLE
--==================================================

local function WaitForStableRespawn(OldCharacter)

    print("ESPERANDO RESPAWN...")

    local Character

    repeat
        task.wait()
        Character = Player.Character
    until Character
        and Character ~= OldCharacter
        and Character.Parent

    local Humanoid =
        Character:WaitForChild("Humanoid")

    local Root =
        Character:WaitForChild(
            "HumanoidRootPart"
        )

    while Humanoid.Health <= 0 do
        task.wait()
    end

    local LastPosition = Root.Position
    local StableTime = 0

    while StableTime < 0.4 do

        task.wait(0.05)

        if not Character.Parent then
            return WaitForStableRespawn(
                OldCharacter
            )
        end

        if not Root.Parent then

            Root =
                Character:WaitForChild(
                    "HumanoidRootPart"
                )

            LastPosition = Root.Position
            StableTime = 0

            continue
        end

        local CurrentPosition = Root.Position

        local Movement =
            (CurrentPosition - LastPosition).Magnitude

        if Movement < 0.05 then
            StableTime += 0.05
        else
            StableTime = 0
        end

        LastPosition = CurrentPosition
    end

    print("RESPAWN ESTABLE")

    return Character
end

