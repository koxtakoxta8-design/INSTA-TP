local function UpdateButton()

    if InstaTP_Enabled then

        Button.Text = "ON"

        Indicator.BackgroundColor3 =
            Color3.fromRGB(255,255,255)

        TweenService:Create(
            Button,
            TweenInfo.new(0.2),
            {
                BackgroundColor3 =
                    Color3.fromRGB(8,8,8)
            }
        ):Play()

    else

        Button.Text = "OFF"

        Indicator.BackgroundColor3 =
            Color3.fromRGB(70,70,70)

        TweenService:Create(
            Button,
            TweenInfo.new(0.2),
            {
                BackgroundColor3 =
                    Color3.fromRGB(25,25,25)
            }
        ):Play()
    end
end

